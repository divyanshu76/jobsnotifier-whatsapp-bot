# Copy this file to .env and fill in your own values. Never commit .env.

# WhatsApp group to notify. Find it with: npm run groups
WP_GROUP=paste_your_group_id_here@g.us

# true = never send; print the messages instead (same as npm run dry-run, but for the scheduled bot)
DRY_RUN=false

# true = also run one check right after the bot starts (otherwise only at minute 0 and 30 of each hour)
RUN_ON_START=false

# How many of the newest entries per homepage section are checked on each run
LIMIT_ADMIT_CARD=3
LIMIT_RESULT=3
LIMIT_ADMISSION=3
LIMIT_LATEST_JOB=2

# Pause between consecutive WhatsApp messages (milliseconds)
SEND_DELAY_MS=3000

# Folders (relative to the project folder)
AUTH_DIR=auth
DATA_DIR=data
LOG_DIR=logs

# Baileys internal log level: silent | error | warn | info | debug
WA_LOG_LEVEL=silent

# Message format: compact  = compact notifications (default; source: sarkariresult.com.cm only)
#                 detailed = full structured notifications (source: www.sarkariresult.com)
# Preview first with: npm run dry-run -- --format=compact   or   npm run preview -- <post url> --format=compact
MESSAGE_FORMAT=compact
